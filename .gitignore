# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Runtime data (regenerated or user-owned)
# - extracted frames + segmentation cache
backend/data/cache/
# - user clips stay on the user's machine
backend/data/uploads/*
!backend/data/uploads/.gitkeep
# - CAMUS downloads: the original host's terms apply; never redistributed
backend/data/camus_raw/
# - regenerated by scripts/prepare_samples.py (CAMUS-derived clips must not be redistributed)
backend/data/samples/*
!backend/data/samples/.gitkeep

# Local tooling
backups/
frontend/_bc_verify.html
frontend/_verify*.html
.DS_Store
